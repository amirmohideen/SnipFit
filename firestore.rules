rules_version = '2';

// Snipfit Firestore rules. The credit ledger, try-on requests and moderation
// data are written only by Cloud Functions (Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Balances, Pro status and suspension: read-only for the owner.
      allow read: if isOwner(uid);
      allow write: if false;

      // Consent records: append-only proof of what was accepted and when.
      match /consents/{consentId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasAll(['type', 'version', 'accepted', 'at', 'appVersion', 'locale'])
          && request.resource.data.type in ['terms', 'biometric', 'ai', 'age', 'analytics']
          && request.resource.data.accepted is bool
          && request.resource.data.version is string
          && request.resource.data.serverAt == request.time
          && (!('isAdult' in request.resource.data) || request.resource.data.isAdult is bool)
          && request.resource.data.size() <= 12;
        allow update, delete: if false;
      }

      match /ledger/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Push tokens for "your try-on is ready".
      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token == token;
      }
    }

    match /tryonRequests/{requestId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Everything else (rcEvents, rateLimits, aiSpendDays, moderationReports)
    // is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
